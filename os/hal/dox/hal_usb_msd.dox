/**
 * @defgroup HAL_USB_MSD USB Mass Storage Driver
 * @brief   USB Mass Storage class driver.
 * @details This module exports a block device as a USB Mass Storage device
 *          with a single logical unit, using the Bulk-Only Transport and
 *          the SCSI transparent command set. Commands are served by an
 *          application thread calling @p msdServe() in a loop.
 * @pre     The USB driver must be enabled with @p HAL_USE_USB and
 *          @p USB_USE_EP0_THREAD must be @p FALSE in @p halconf.h.
 *
 * @ingroup HAL_COMPLEX_DRIVERS
 */
