/**
 * @defgroup HAL_GPIO_QENCODER GPIO Quadrature Encoder Driver
 * @brief   Quadrature encoder on GPIO pad events.
 * @details This module implements the @p BaseEncoder interface decoding
 *          the A/B/index lines of a quadrature encoder in software, using
 *          the PAL pad event callbacks. Any platform with
 *          @p PAL_USE_CALLBACKS can be used.
 *
 * @ingroup HAL_COMPLEX_DRIVERS
 */
