/*
 * XHAL architecture diagrams, PlantUML source, not part of the
 * documentation.
 *
 * @startuml {xhal_drvsm.png} "XHAL Drivers State Machine"
 * hide empty description
 *
 * state UNINIT
 * state STOP
 * state STARTING
 * state READY
 * state ACTIVE
 * state STOPPING
 * note right of STARTING
 *   Set while the low level
 *   driver starts the peripheral.
 * end note
 * note right of STOPPING
 *   Set while the low level
 *   driver stops the peripheral.
 * end note
 * note right of ACTIVE
 *   Used by drivers implementing
 *   asynchronous operations.
 * end note
 *
 * [*] --> UNINIT
 * UNINIT --> STOP : xxxObjectInit()
 * STOP --> STOP : drvStop()\nignored
 * STOP --> STARTING : drvStart()
 * STARTING --> READY : start\nsucceeded
 * STARTING --> STOP : start\nfailed
 * READY --> READY : drvStart(NULL) ignored\ndrvStart(config)\ndrvSetCfgX()\ndrvSelectCfgX()
 * READY --> ACTIVE : operation\nstarted
 * ACTIVE -[dotted]-> READY : operation\nended
 * READY --> STOPPING : drvStop()
 * ACTIVE --> STOPPING : drvStop()\noperation aborted
 * STOPPING --> STOP : stop\ncompleted
 *
 * @enduml
 *
 * @startuml {xhal_cbsm.png} "XHAL Callback Drivers Transient States"
 * hide empty description
 *
 * state ACTIVE
 * state READY
 * state "Callback executing" as CB {
 *   state HALF
 *   state FULL
 *   state COMPLETE
 *   state ERROR
 * }
 * note as N1
 *   Transient states, the callback reads them with
 *   drvStateIsHalfX(), drvStateIsCompleteX() and
 *   drvStateIsErrorX(). A state change made by the
 *   callback, for example starting a new operation,
 *   is kept. Without a callback the driver goes
 *   directly to the final state.
 * end note
 *
 * ACTIVE -[dotted]-> HALF : first half of a\ncircular buffer
 * HALF --> ACTIVE : callback\nreturned
 * ACTIVE -[dotted]-> FULL : second half of a\ncircular buffer
 * FULL --> ACTIVE : callback\nreturned
 * ACTIVE -[dotted]-> COMPLETE : operation\ncompleted
 * COMPLETE --> READY : callback\nreturned
 * ACTIVE -[dotted]-> ERROR : operation\nfailed
 * ERROR --> READY : callback\nreturned
 *
 * @enduml
 *
 * @startuml {xhal_arch.png} "XHAL Architecture"
 * set separator none
 *
 * package "Base OOP Package" {
 *   interface base_interface_i {
 *     + {static} oopIfGetOwner()
 *     + {static} oopIfObjectInit()
 *   }
 *   interface sequential_stream_i extends base_interface_i {
 *     + {abstract} stmWrite()
 *     + {abstract} stmRead()
 *     + {abstract} stmPut()
 *     + {abstract} stmGet()
 *     + {abstract} stmUnget()
 *   }
 *   abstract class base_object_c {
 *     - vmt: const void *
 *     # __bo_objinit_impl()
 *     # {abstract} __bo_dispose_impl()
 *     + {static} oopGetOwner()
 *     + {static} oopGetIf()
 *     + {static} oopAssert()
 *     + {static} oopLock()
 *     + {static} oopUnlock()
 *   }
 *   abstract class referenced_object_c extends base_object_c {
 *     - references: object_references_t
 *     # __ro_objinit_impl()
 *     # {abstract} __ro_dispose_impl()
 *     # __ro_addref_impl()
 *     # __ro_release_impl()
 *     + roAddRef()
 *     + roRelease()
 *   }
 *   abstract class synchronized_object_c extends referenced_object_c {
 *     - mutex: mutex_t
 *     # __so_objinit_impl()
 *     # {abstract} __so_dispose_impl()
 *     + soLock()
 *     + soUnlock()
 *   }
 * }
 * package "XHAL Common Classes" {
 *   interface asynchronous_channel_i extends sequential_stream_i {
 *     + {abstract} chnWriteTimeout()
 *     + {abstract} chnReadTimeout()
 *     + {abstract} chnPutTimeout()
 *     + {abstract} chnGetTimeout()
 *     + {abstract} chnGetAndClearFlags()
 *     + {abstract} chnControl()
 *   }
 *   abstract class hal_base_driver_c extends base_object_c {
 *     - state: driver_state_t
 *     - config: const void *
 *     - arg: void *
 *     - mutex: driver_mutex_t
 *     - name: const char *
 *     - regent: hal_regent_t
 *     # {abstract} __drv_start()
 *     # {abstract} __drv_stop()
 *     # {abstract} __drv_set_cfg()
 *     # {abstract} __drv_sel_cfg()
 *     # __drv_objinit_impl()
 *     # __drv_dispose_impl()
 *     + {static} drvInit()
 *     + {static} drvRegGetFirstI()
 *     + {static} drvRegGetNextI()
 *     + {static} drvStartByName()
 *     + drvStart()
 *     + drvStop()
 *     + drvSetCfgX()
 *     + drvSelectCfgX()
 *     + drvGetStateX()
 *     + drvSetStateX()
 *     + drvGetArgumentX()
 *     + drvSetArgumentX()
 *     + drvRegister()
 *     + drvUnregister()
 *     + drvGetNameX()
 *     + drvLock()
 *     + drvUnlock()
 *   }
 *   abstract class hal_cb_driver_c extends hal_base_driver_c {
 *     - cb: drv_cb_t
 *     # __cbdrv_on_cb_set()
 *     + drvSetCallbackX()
 *     + drvGetCallbackX()
 *     + drvStateIsHalfX()
 *     + drvStateIsCompleteX()
 *     + drvStateIsErrorX()
 *   }
 * }
 * package "XHAL Drivers" {
 *   class hal_sio_driver_c extends hal_cb_driver_c \
 *                      implements asynchronous_channel_i {
 *     - enabled: sioevents_t
 *     - sync_rx: thread_reference_t
 *     - sync_rxidle: thread_reference_t
 *     - sync_tx: thread_reference_t
 *     - sync_txend: thread_reference_t
 *     ~ {static} sioInit()
 *     + sioObjectInit()
 *     + sioWriteEnableFlags()
 *     + sioSetEnableFlags()
 *     + sioClearEnableFlags()
 *     + sioGetAndClearErrors()
 *     + sioGetAndClearEvents()
 *     + sioGetEvents()
 *     + sioSynchronizeRX()
 *     + sioSynchronizeRXIdle()
 *     + sioSynchronizeTX()
 *     + sioSynchronizeTXEnd()
 *   }
 *   class hal_pwm_driver_c extends hal_cb_driver_c {
 *     ~ {static} pwmInit()
 *     + pwmObjectInit()
 *     + pwmChangePeriod()
 *     + pwmEnableChannel()
 *     + pwmDisableChannel()
 *     + pwmEnablePeriodicNotification()
 *     + pwmEnableChannelNotification()
 *   }
 *   class hal_buffered_sio_c extends hal_base_driver_c \
 *                            implements asynchronous_channel_i {
 *     - siop: hal_sio_driver_c *
 *     - iqueue: input_queue_t
 *     - oqueue: output_queue_t
 *     - event: event_source_t
 *     + bsioObjectInit()
 *     # bsIncomingDataI()
 *     # bsRequestDataI()
 *     # bsAddFlagsI()
 *   }
 *   hal_buffered_sio_c "1" o-- "1" hal_sio_driver_c
 * }
 * @enduml
 */
