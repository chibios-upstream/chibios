/* Interfaces and classes.                                                   */
/*===========================================================================*/

/**
 * @defgroup HAL_BASE_DRIVER Base Driver
 * @brief   Common driver base abstract class.
 * @details Lifecycle, configuration selection, mutual exclusion and registry
 *          integration common to all the XHAL stateful drivers.
 *
 * @ingroup HAL_INTERFACES_CLASSES
 */

/**
 * @defgroup HAL_CB_DRIVER Callback Driver
 * @brief   Common ancestor of callback-based drivers.
 *
 * @ingroup HAL_INTERFACES_CLASSES
 */

/**
 * @defgroup HAL_CHANNELS I/O Channels
 * @brief   Sequential data streams interface.
 *
 * @ingroup HAL_INTERFACES_CLASSES
 */

/**
 * @defgroup HAL_BLOCK_IO Block I/O
 * @brief   Block devices interface.
 *
 * @ingroup HAL_INTERFACES_CLASSES
 */

/**
 * @defgroup HAL_TTY Terminal Interface
 * @brief   Generic terminal interface.
 *
 * @ingroup HAL_INTERFACES_CLASSES
 */

/**
 * @defgroup HAL_FLASH_BASE Flash Base Driver
 * @brief   Common base class for flash devices.
 *
 * @ingroup HAL_INTERFACES_CLASSES
 */

/**
 * @defgroup HAL_FLASH Flash Compatibility
 * @brief   Flash compatibility facade.
 *
 * @ingroup HAL_INTERFACES_CLASSES
 */

