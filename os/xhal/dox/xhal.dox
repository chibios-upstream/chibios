/**
 * @defgroup XHAL XHAL
 * @brief   Object-oriented Hardware Abstraction Layer.
 * @details XHAL is the object-oriented evolution of the ChibiOS HAL. Device
 *          drivers are classes deriving from a common base driver class,
 *          high level driver interfaces and common code are generated from
 *          XML descriptions, configuration is selected at runtime among a
 *          set of configurations and drivers can be enumerated through a
 *          registry. See @ref xhal_concepts for an overview of the driver
 *          model.
 */

/**
 * @defgroup XHAL_CONF Configuration
 * @brief   XHAL Configuration.
 * @details The file @p xhalconf.h contains the high level settings for all
 *          the drivers supported by XHAL.
 *
 * @ingroup XHAL
 */

/**
 * @defgroup HAL_NORMAL_DRIVERS Normal Drivers
 * @brief   XHAL Normal Drivers.
 * @details Drivers interfacing the application to an MCU peripheral through
 *          a portable API, split in a high level part and a platform
 *          specific low level part.
 *
 * @ingroup XHAL
 */

/**
 * @defgroup HAL_COMPLEX_DRIVERS Complex Drivers
 * @brief   XHAL Complex Drivers.
 * @details Drivers that are fully portable, they use other drivers or
 *          interfaces in order to implement their function.
 *
 * @ingroup XHAL
 */

/**
 * @defgroup HAL_INTERFACES_CLASSES Interfaces and Classes
 * @brief   XHAL Interfaces and Classes.
 * @details Abstract interfaces and base classes implemented or inherited by
 *          the XHAL drivers.
 *
 * @ingroup XHAL
 */

/**
 * @defgroup HAL_INNER_CODE Inner Code
 * @brief   XHAL Inner Code.
 * @details Code used internally by the XHAL drivers.
 *
 * @ingroup XHAL
 */

/**
 * @defgroup HAL_SUPPORT Support Code
 * @brief   XHAL Support Code.
 * @details Helpers and bindings to other subsystems.
 *
 * @ingroup XHAL
 */

/**
 * @defgroup HAL_SAFETY Safety Subsystem
 * @brief   XHAL Safety Manager.
 *
 * @ingroup XHAL
 */

