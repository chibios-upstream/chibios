 * @brief   Generic Ethernet Driver.
 * @pre     In order to use the ETH driver the @p HAL_USE_ETH option
 *          must be enabled in @p xhalconf.h.
 *
 * @ingroup HAL_NORMAL_DRIVERS
 */

/**
 * @defgroup HAL_GPT GPT Driver
 * @brief   Generic General Purpose Timer Driver.
 * @pre     In order to use the GPT driver the @p HAL_USE_GPT option
 *          must be enabled in @p xhalconf.h.
