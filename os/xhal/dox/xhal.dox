 * @ingroup HAL_NORMAL_DRIVERS
 */

/**
 * @defgroup HAL_ICU ICU Driver
 * @brief   Generic Input Capture Unit Driver.
 * @pre     In order to use the ICU driver the @p HAL_USE_ICU option
