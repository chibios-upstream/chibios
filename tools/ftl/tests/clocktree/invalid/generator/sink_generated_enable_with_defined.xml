<clocktree>
  <settings>
    <prefixes clock_points="TCLK_" macros="TST_" cfgs="TST_CFG_" />
    <suffixes frequency="_FREQ" values="_VALUE" bits="_BITS"
              selector="_SEL" enable="_ENABLE" enabled="_ENABLED" />
    <configs>
      <config name="CLOCK_DYNAMIC" type="bool" default="FALSE"
              role="dynamic_mode">
        <description>Enables dynamic clock handling.</description>
      </config>
    </configs>
  </settings>
  <clocks>
    <clock point="ROOT" enable="manual" dynamic="no">
      <description>root clock conditionally required by the consumer</description>
      <bits enabled="RCC_ROOT_ON" disabled="0U" />
      <derived frequency="1000000U" />
    </clock>
    <clock point="CONSUMER" enable="always" dynamic="no">
      <description>consumer with an invalid root dependency</description>
      <derived frequency="1000000U" />
    </clock>
  </clocks>
  <sinks>
    <sink name="CONSUMER_ROOT" input="ROOT"
          condition="(TST_CONSUMER_ENABLED == TRUE) &amp;&amp; defined(TST_ROOT_REQUIRED)">
      <description>The invalid dependency combines delayed and eager expressions.</description>
    </sink>
  </sinks>
</clocktree>
