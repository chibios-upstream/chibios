<clocktree>
  <settings>
    <prefixes clock_points="TCLK_" macros="TST_" cfgs="TST_CFG_" />
    <suffixes frequency="_FREQ" values="_VALUE" bits="_BITS"
              selector="_SEL" enable="_ENABLE" enabled="_ENABLED" />
    <configs>
      <config name="CLOCK_DYNAMIC" type="bool" default="FALSE"
              role="dynamic_mode">
        <description>Enables dynamic clock handling.</description>
      </config>
    </configs>
  </settings>
  <clocks>
    <clock point="PERIPH" enable="auto" dynamic="no">
      <description>peripheral root clock</description>
      <derived frequency="1000000U" />
    </clock>
  </clocks>
  <sinks>
    <sink name="PERIPH" input="PERIPH">
      <description>External software demands the peripheral clock.</description>
    </sink>
  </sinks>
</clocktree>
